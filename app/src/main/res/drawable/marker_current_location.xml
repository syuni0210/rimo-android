<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 바깥쪽 흰색 테두리 -->
    <item>
        <shape android:shape="oval">

            <size
                android:width="20dp"
                android:height="20dp" />

            <solid android:color="#FFFFFF" />

        </shape>
    </item>

    <!-- 안쪽 파란 원 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="oval">

            <solid android:color="#3B82F6" />

        </shape>
    </item>

</layer-list>