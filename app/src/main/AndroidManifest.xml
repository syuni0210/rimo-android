<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 고정된 위치에 액세스할 수 있는 권한을 부여 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 위치 권한 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ⭐️ 안드로이드 10(API 29) 이상 백그라운드 위치 권한 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ⭐️ 앱을 닫아도 위치 전송을 유지하기 위한 포그라운드 서비스 권한 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 긴급 알림 및 상태 확인 시 진동 기능 사용 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- networkSecurityConfig 추가함 - localhost HTTP 통신 허용을 위한 네트워크 보안 설정 -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".App"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/rimo"
        android:label="RIMO"
        android:roundIcon="@mipmap/rimo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudDX_Team4_Project">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="RIMO"
            android:theme="@style/Theme.CloudDX_Team4_Project"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
        <service
            android:name=".service.RimoSafeBackgroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>